# ──────────────────────────────────────────────────────────────
# VlogMCP — environment variables
#
# All settings are now stored in vlog-mcp.json (see vlog-mcp.example.json).
# The only env var you normally need is the one below — to tell the server
# where to find that file.
# ──────────────────────────────────────────────────────────────

# Path to your vlog-mcp.json config file.
# Defaults to ./vlog-mcp.json relative to the working directory.
VLOG_MCP_CONFIG=./vlog-mcp.json

# ── CI/CD fallback ─────────────────────────────────────────────
# If vlog-mcp.json is absent, individual keys can still be passed
# as env vars (useful in Docker / GitHub Actions without a config file).
#
# VLOG_MCP_WORKSPACE=./vlog-workspace
# VLOG_MCP_BRANDING_PATH=./branding/branding.json
# VLOG_MCP_LIBRARY_PATH=./library/index.json
# VLOG_MCP_OPENAI_KEY=sk-...
# VLOG_MCP_OPENAI_BASE_URL=
# VLOG_MCP_ELEVENLABS_KEY=
# VLOG_MCP_STABILITY_KEY=
# VLOG_MCP_TELEGRAM_TOKEN=
# VLOG_MCP_TELEGRAM_CHAT_ID=
